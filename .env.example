# ==============================================================================
# GRAYPLASMA WEB - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env.local untuk development, atau masukkan ke Vercel Environment Variables.
# ==============================================================================

# 1. Supabase Configuration (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Production Domain URL (Untuk OpenGraph share card & Sitemap)
# Contoh: https://grayplasma.id atau https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=https://grayplasma-web.vercel.app

# 3. Admin Security PIN / Master Password Fallback
ADMIN_PIN=grayplasma2026
